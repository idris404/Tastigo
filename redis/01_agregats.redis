# =====================================================================
#  Tastigo - 01 : les agrégats en Redis (+ exemples d'utilisation)
# ---------------------------------------------------------------------
#  Lancer :  ./redis/run.sh 01_agregats.redis      (Git Bash)
#            .\redis\run.ps1 01_agregats.redis     (PowerShell)
#
#  Chaque service a sa propre base -> une base Redis par service :
#     DB 1 = restaurant      DB 2 = commande      DB 3 = livraison
#  (la DB 0 sert de bus d'événements dans 02_evenements.redis)
#
#  Redis n'a pas de documents imbriqués : un agrégat JSON est découpé
#  en plusieurs clés qui partagent le même préfixe :
#     champs simples        -> HASH   <type>:<id>
#     sous-objet (adresse)  -> HASH   <type>:<id>:adresse
#     liste d'éléments      -> SET/LIST d'ids + un HASH par élément
#  Booléens stockés en "true"/"false" ; null = champ absent du HASH.
#  Comme l'agrégat est réparti sur plusieurs clés, on l'écrit dans un
#  MULTI/EXEC pour qu'il ne soit jamais à moitié créé.
#
#  Attention : pas de commentaire en fin de ligne, seules les lignes
#  qui COMMENCENT par # sont retirées avant l'envoi à redis-cli.
# =====================================================================


# =====================================================================
#  SERVICE RESTAURANT  (DB 1)
# ---------------------------------------------------------------------
#  restaurant:<id>               HASH  restaurantId, nom, ouvert
#  restaurant:<id>:adresse       HASH  rue, ville, codePostal
#  restaurant:<id>:horaires      HASH  jour -> "ouverture-fermeture"
#  restaurant:<id>:plats         SET   ids des plats
#  restaurant:<id>:plat:<platId> HASH  platId, nom, prix, disponible
#  restaurants                   SET   index : tous les restaurants
#  restaurants:ouverts           SET   index : restaurants ouverts
# =====================================================================
SELECT 1
FLUSHDB

ECHO "===== SERVICE RESTAURANT (DB 1) ====="
ECHO "--- Creation de l'agregat Restaurant R1 ---"
MULTI
HSET restaurant:R1 restaurantId R1 nom "Chez Ali" ouvert true
HSET restaurant:R1:adresse rue "12 rue Victor Hugo" ville Lyon codePostal 69002
HSET restaurant:R1:horaires LUNDI 11:00-23:00 MARDI 11:00-23:00 SAMEDI 18:00-01:00
SADD restaurant:R1:plats P1 P2
HSET restaurant:R1:plat:P1 platId P1 nom Pizza prix 12 disponible true
HSET restaurant:R1:plat:P2 platId P2 nom Tacos prix 8 disponible false
SADD restaurants R1
SADD restaurants:ouverts R1
EXEC

# Un 2e restaurant, fermé, pour que les exemples de recherche aient du sens
ECHO "--- Creation de l'agregat Restaurant R2 (ferme) ---"
MULTI
HSET restaurant:R2 restaurantId R2 nom "Sushi Bar" ouvert false
HSET restaurant:R2:adresse rue "5 quai Saint-Antoine" ville Lyon codePostal 69002
HSET restaurant:R2:horaires MARDI 12:00-22:00
SADD restaurant:R2:plats P4
HSET restaurant:R2:plat:P4 platId P4 nom "Maki saumon" prix 6 disponible true
SADD restaurants R2
EXEC

# --- Lectures ---------------------------------------------------------
ECHO "--- Lire tout le restaurant R1 ---"
HGETALL restaurant:R1
HGETALL restaurant:R1:adresse
HGETALL restaurant:R1:horaires

ECHO "--- Le menu de R1 : ids des plats puis chaque plat ---"
SMEMBERS restaurant:R1:plats
HGETALL restaurant:R1:plat:P1
HGETALL restaurant:R1:plat:P2

ECHO "--- Seulement le nom et le prix d'un plat (HMGET) ---"
HMGET restaurant:R1:plat:P1 nom prix

ECHO "--- Horaire du samedi ---"
HGET restaurant:R1:horaires SAMEDI

ECHO "--- Le client voit les restaurants ouverts ---"
SMEMBERS restaurants:ouverts

ECHO "--- Les restaurants fermes (SDIFF tous - ouverts) ---"
SDIFF restaurants restaurants:ouverts

# --- Mises à jour -----------------------------------------------------
ECHO "--- Le prix de la pizza passe de 12 a 14 ---"
HSET restaurant:R1:plat:P1 prix 14
HGET restaurant:R1:plat:P1 prix

ECHO "--- Les tacos redeviennent disponibles ---"
HSET restaurant:R1:plat:P2 disponible true
HGET restaurant:R1:plat:P2 disponible

ECHO "--- R2 ouvre : on met a jour l'agregat ET l'index ensemble ---"
MULTI
HSET restaurant:R2 ouvert true
SADD restaurants:ouverts R2
EXEC
SMEMBERS restaurants:ouverts

ECHO "--- Ajouter un plat P3 a R1 ---"
MULTI
SADD restaurant:R1:plats P3
HSET restaurant:R1:plat:P3 platId P3 nom Salade prix 7 disponible true
EXEC
SMEMBERS restaurant:R1:plats

ECHO "--- Supprimer le plat P3 ---"
MULTI
SREM restaurant:R1:plats P3
DEL restaurant:R1:plat:P3
EXEC
SMEMBERS restaurant:R1:plats

ECHO "--- Toutes les cles de l'agregat R1 (KEYS : ok en demo, SCAN en prod) ---"
KEYS restaurant:R1*


# =====================================================================
#  SERVICE COMMANDE  (DB 2)
# ---------------------------------------------------------------------
#  commande:<id>                   HASH  commandeId, clientId, restaurantId,
#                                        montantTotal, statut, dateCreation
#  commande:<id>:adresseLivraison  HASH  rue, ville, codePostal
#  commande:<id>:lignes            LIST  ids des plats, dans l'ordre
#  commande:<id>:ligne:<platId>    HASH  platId, nomPlat, prixUnitaire, quantite
#  client:<id>:commandes           ZSET  commandes du client, score = date AAAAMMJJhhmm
#
#  statut : PASSEE, VALIDEE, REFUSEE, ANNULEE, EN_LIVRAISON, TERMINEE
# =====================================================================
SELECT 2
FLUSHDB

ECHO "===== SERVICE COMMANDE (DB 2) ====="
ECHO "--- Le client U7 passe la commande C42 : 2 pizzas chez R1 ---"
# Le prix est COPIÉ dans la ligne : si le restaurant change son prix
# plus tard, la commande garde le prix payé.
# montantTotal part de 0 et HINCRBY ajoute prixUnitaire x quantite.
MULTI
HSET commande:C42 commandeId C42 clientId U7 restaurantId R1 montantTotal 0 statut PASSEE dateCreation 2026-10-07T12:30:00
HSET commande:C42:adresseLivraison rue "3 place Bellecour" ville Lyon codePostal 69002
RPUSH commande:C42:lignes P1
HSET commande:C42:ligne:P1 platId P1 nomPlat Pizza prixUnitaire 12 quantite 2
HINCRBY commande:C42 montantTotal 24
ZADD client:U7:commandes 202610071230 C42
EXEC

ECHO "--- Lire la commande C42 ---"
HGETALL commande:C42
HGETALL commande:C42:adresseLivraison
LRANGE commande:C42:lignes 0 -1
HGETALL commande:C42:ligne:P1

ECHO "--- Validation de C42 : PASSEE -> VALIDEE ---"
HSET commande:C42 statut VALIDEE
HGET commande:C42 statut

ECHO "--- Une 2e commande C43 de U7 avec 2 lignes (12x1 + 8x2 = 28) ---"
MULTI
HSET commande:C43 commandeId C43 clientId U7 restaurantId R1 montantTotal 0 statut PASSEE dateCreation 2026-10-08T19:05:00
HSET commande:C43:adresseLivraison rue "3 place Bellecour" ville Lyon codePostal 69002
RPUSH commande:C43:lignes P1 P2
HSET commande:C43:ligne:P1 platId P1 nomPlat Pizza prixUnitaire 12 quantite 1
HSET commande:C43:ligne:P2 platId P2 nomPlat Tacos prixUnitaire 8 quantite 2
HINCRBY commande:C43 montantTotal 12
HINCRBY commande:C43 montantTotal 16
ZADD client:U7:commandes 202610081905 C43
EXEC
HGET commande:C43 montantTotal

ECHO "--- Le client ajoute 1 tacos de plus a C43 (quantite +1, total +8) ---"
MULTI
HINCRBY commande:C43:ligne:P2 quantite 1
HINCRBY commande:C43 montantTotal 8
EXEC

ECHO "--- Le client annule C43 ---"
HSET commande:C43 statut ANNULEE
HMGET commande:C43 statut montantTotal

ECHO "--- Historique des commandes de U7, de la plus recente a la plus ancienne ---"
ZREVRANGE client:U7:commandes 0 -1 WITHSCORES

ECHO "--- Les commandes de U7 passees le 8 octobre 2026 ---"
ZRANGEBYSCORE client:U7:commandes 202610080000 202610082359


# =====================================================================
#  SERVICE LIVRAISON  (DB 3)
# ---------------------------------------------------------------------
#  livraison:<id>                   HASH  livraisonId, commandeId, statut,
#                                         dateCreation, dateLivraison
#  livraison:<id>:adresseRetrait    HASH  rue, ville, codePostal
#  livraison:<id>:adresseLivraison  HASH  rue, ville, codePostal
#  livraison:<id>:livreur           HASH  nom, telephone
#  livraisons:par-commande          HASH  commandeId -> livraisonId
#
#  statut : EN_PREPARATION, EN_ROUTE, LIVREE, ANNULEE
#  dateLivraison = null tant que ce n'est pas livré -> le champ est absent
# =====================================================================
SELECT 3
FLUSHDB

ECHO "===== SERVICE LIVRAISON (DB 3) ====="
ECHO "--- Creation de la livraison L9 pour la commande C42 (pas encore de livreur) ---"
MULTI
HSET livraison:L9 livraisonId L9 commandeId C42 statut EN_PREPARATION dateCreation 2026-10-07T12:31:00
HSET livraison:L9:adresseRetrait rue "12 rue Victor Hugo" ville Lyon codePostal 69002
HSET livraison:L9:adresseLivraison rue "3 place Bellecour" ville Lyon codePostal 69002
HSET livraisons:par-commande C42 L9
EXEC
HGETALL livraison:L9

ECHO "--- dateLivraison est null : le champ n'existe pas (HEXISTS -> 0) ---"
HEXISTS livraison:L9 dateLivraison

ECHO "--- Karim prend la livraison : livreur + statut EN_ROUTE ---"
MULTI
HSET livraison:L9:livreur nom Karim telephone 0600000000
HSET livraison:L9 statut EN_ROUTE
EXEC
HGETALL livraison:L9:livreur
HGET livraison:L9 statut

ECHO "--- Suivi par le client : retrouver la livraison a partir de la commande ---"
HGET livraisons:par-commande C42
HMGET livraison:L9 statut dateLivraison

ECHO "--- Livree : statut LIVREE + dateLivraison ---"
HSET livraison:L9 statut LIVREE dateLivraison 2026-10-07T12:58:00
HGETALL livraison:L9
HEXISTS livraison:L9 dateLivraison

ECHO "===== FIN : nombre de cles par base ====="
SELECT 1
DBSIZE
SELECT 2
DBSIZE
SELECT 3
DBSIZE
